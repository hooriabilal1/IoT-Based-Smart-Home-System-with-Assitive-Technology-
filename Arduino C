#include "BluetoothSerial.h"
#include "Wire.h"
BluetoothSerial SerialBT;

#define SENSOR_ADDR 0x27  // I2C address of the Honeywell HIH7000 sensor
#define SDA 21
#define SCL 22
const int PIR_SENSOR = 25; // GPIO pin for motion sensor

// Global variables to store raw data (moved to top)
uint16_t rawHumidity = 0;
uint16_t rawTemperature = 0;

void setup() {
  Serial.begin(115200);           // Start serial communication
  SerialBT.begin("ESP32B");       // Start Bluetooth with device name "ESP32B"
  Wire.begin(SDA, SCL);           // Initialize I2C

  pinMode(PIR_SENSOR, INPUT);

  // Check if the sensor is responding
  Wire.beginTransmission(SENSOR_ADDR);
  if (Wire.endTransmission() != 0) {
    Serial.println("Sensor not found!");
    SerialBT.println("Sensor not found!");
    while (1);  // Halt if sensor is not found
  }

  Serial.println("Sensor found!");
  SerialBT.println("Sensor found!");
}

void loop() {
  // Read and display humidity and temperature together
  if (readSensorData()) {
    float humidity = convertToRH(rawHumidity);
    float temperature = convertToCelsius(rawTemperature);

    // Output humidity
    Serial.print("\nHumidity: ");
    Serial.print(humidity);
    Serial.println(" %RH");

    SerialBT.print("\nHumidity: ");
    SerialBT.print(humidity);
    SerialBT.println(" %RH");

    // Output temperature
    Serial.print("Temperature: ");
    Serial.print(temperature);
    Serial.println(" °C");

    SerialBT.print("Temperature: ");
    SerialBT.print(temperature);
    SerialBT.println(" °C");
  }

  // Detect and output motion state
  int motion = digitalRead(PIR_SENSOR);
  Serial.print("\nMotion: ");
  Serial.println(motion);  // Output 1 or 0

  SerialBT.print("\nMotion: ");
  SerialBT.println(motion);  // Output 1 or 0

  delay(1000);  // Update every second
}

// Read raw humidity and temperature from sensor
bool readSensorData() {
  // Request measurement (no register address needed for HIH7000 series)
  Wire.beginTransmission(SENSOR_ADDR);
  Wire.endTransmission();

  delay(100);  // Wait for measurement to complete (typical response time ~36.65ms)

  // Request 4 bytes: 2 for humidity, 2 for temperature
  Wire.requestFrom(SENSOR_ADDR, 4);
  if (Wire.available() == 4) {
    uint8_t humHigh = Wire.read();
    uint8_t humLow = Wire.read();
    uint8_t tempHigh = Wire.read();
    uint8_t tempLow = Wire.read();

    // Combine bytes and mask status bits for humidity
    rawHumidity = ((humHigh & 0x3F) << 8) | humLow;  // Mask first 2 bits (status bits)
    rawTemperature = (tempHigh << 8) | tempLow;

    return true;
  }
  return false;
}

// Convert raw humidity to %RH
float convertToRH(uint16_t rawHumidity) {
  // Formula from HIH7000 series datasheet: %RH = (raw / (2^14 - 2)) * 100
  return (rawHumidity / 16382.0) * 100.0;
}

// Convert raw temperature to °C
float convertToCelsius(uint16_t rawTemperature) {
  // Formula from HIH7000 series datasheet: Temp (°C) = (raw / (2^14 - 2)) * 165 - 40
  return (rawTemperature / 16382.0) * 165.0 - 40.0;
}
