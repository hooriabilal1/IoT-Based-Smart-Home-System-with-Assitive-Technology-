    def create_plot(self, title, ylabel):
        fig = plt.Figure(figsize=(5, 3), dpi=100)
        ax = fig.add_subplot(111)
        ax.set_title(title, fontsize=12)
        ax.set_xlabel('Time (s)', fontsize=10)
        ax.set_ylabel(ylabel, fontsize=10)
        ax.grid(True)
        if "Acceleration" in title:
            ax.set_ylim(-20, 20)
        elif "Total Acceleration" in title:
            ax.set_ylim(0, 20)
        elif "Angles" in title:
            ax.set_ylim(-180, 180)
        elif "Total Angle" in title:
            ax.set_ylim(0, 360)
        canvas = FigureCanvas(fig)
        return fig, canvas

    def update_plot(self, fig, canvas, x, *ys):
        ax = fig.axes[0]
        original_title = ax.get_title()
        ax.clear()
        ax.set_title(original_title, fontsize=12)
        ax.set_xlabel('Time (s)', fontsize=10)
        ax.set_ylabel(fig.axes[0].get_ylabel(), fontsize=10)
        ax.grid(True)
        if "Acceleration" in original_title:
            ax.set_ylim(-20, 20)
            labels = ['Ax', 'Ay', 'Az']
            for y, label in zip(ys, labels):
                ax.plot(x, y, label=label)
            ax.legend()
        elif "Angles" in original_title:
            ax.set_ylim(-180, 180)
            labels = ['Roll', 'Pitch', 'Yaw']
            for y, label in zip(ys, labels):
                ax.plot(x, y, label=label)
            ax.legend()
        elif "Total Angle" in original_title:
            ax.set_ylim(0, 360)
            ax.plot(x, ys[0], label='Angle Total')
            ax.legend()
        else:
            ax.plot(x, ys[0])
        canvas.draw()

    def updateData(self, newData, device_name):
        global motionA, motionB, tempA, tempB, humidityA, humidityB
        try:
            if "Motion:" in newData:
                # Extract the motion value (1 or 0) after "Motion:"
                motionStatus = int(newData.split("Motion:")[1].strip())
                print(f"[Parsed Motion] Device: {device_name}, Value: {motionStatus}")  # Debug print
                if device_name == "ESP32A":
                    motionA.append((time.time(), motionStatus))
                    if len(motionA) > 50:
                        motionA.pop(0)
                elif device_name == "ESP32B":
                    motionB.append((time.time(), motionStatus))
                    if len(motionB) > 50:
                        motionB.pop(0)
            elif "Temperature:" in newData:
                tempVal = float(newData.split("Temperature:")[1].strip().replace("°C", ""))
                if device_name == "ESP32A":
                    tempA.append((time.time(), tempVal))
                    if len(tempA) > 50:
                        tempA.pop(0)
                elif device_name == "ESP32B":
                    tempB.append((time.time(), tempVal))
                    if len(tempB) > 50:
                        tempB.pop(0)
            elif "Humidity:" in newData:
                humidityVal = float(newData.split("Humidity:")[1].strip().replace("%RH", ""))
                if device_name == "ESP32A":
                    humidityA.append((time.time(), humidityVal))
                    if len(humidityA) > 50:
                        humidityA.pop(0)
                elif device_name == "ESP32B":
                    humidityB.append((time.time(), humidityVal))
                    if len(humidityB) > 50:
                        humidityB.pop(0)
        except Exception as e:
            print(f"[updateData Error] {e}")

    def updateSensorData(self, ax, ay, az, atotal, roll, pitch, yaw, angle_total):
        global accel_data
        accel_data.append((time.time(), ax, ay, az, atotal, roll, pitch, yaw, angle_total))
        if len(accel_data) > 50:
            accel_data.pop(0)

    def updateGraph(self):
        try:
            if motionA:
                x = [t[0] - motionA[0][0] for t in motionA]
                y = [t[1] for t in motionA]
                print(f"[Updating MotionA] Time: {x[-1]:.2f}, Value: {y[-1]}")  # Debug print
                self.update_plot(self.fig_motionA, self.canvas_motionA, x, y)
            if motionB:
                x = [t[0] - motionB[0][0] for t in motionB]
                y = [t[1] for t in motionB]
                print(f"[Updating MotionB] Time: {x[-1]:.2f}, Value: {y[-1]}")  # Debug print
                self.update_plot(self.fig_motionB, self.canvas_motionB, x, y)
            if tempA:
                x = [t[0] - tempA[0][0] for t in tempA]
                y = [t[1] for t in tempA]
                self.update_plot(self.fig_tempA, self.canvas_tempA, x, y)
            if tempB:
                x = [t[0] - tempB[0][0] for t in tempB]
                y = [t[1] for t in tempB]
                self.update_plot(self.fig_tempB, self.canvas_tempB, x, y)
            if humidityA:
                x = [t[0] - humidityA[0][0] for t in humidityA]
                y = [t[1] for t in humidityA]
                self.update_plot(self.fig_humidityA, self.canvas_humidityA, x, y)
            if humidityB:
                x = [t[0] - humidityB[0][0] for t in humidityB]
                y = [t[1] for t in humidityB]
                self.update_plot(self.fig_humidityB, self.canvas_humidityB, x, y)
            if accel_data:
                x = [t[0] - accel_data[0][0] for t in accel_data]
                ax_vals = [t[1] for t in accel_data]
                ay_vals = [t[2] for t in accel_data]
                az_vals = [t[3] for t in accel_data]
                atotal_vals = [t[4] for t in accel_data]
                roll_vals = [t[5] for t in accel_data]
                pitch_vals = [t[6] for t in accel_data]
                yaw_vals = [t[7] for t in accel_data]
                angle_total_vals = [t[8] for t in accel_data]
                self.update_plot(self.fig_accel, self.canvas_accel, x, ax_vals, ay_vals, az_vals)
                self.update_plot(self.fig_atotal, self.canvas_atotal, x, atotal_vals)
                self.update_plot(self.fig_angles, self.canvas_angles, x, roll_vals, pitch_vals, yaw_vals)
                self.update_plot(self.fig_angle_total, self.canvas_angle_total, x, angle_total_vals)
        except Exception as e:
            print(f"[updateGraph Error] {e}")

    def save_data_to_csv(self):
        try:
            from pathlib import Path
            save_dir = Path(r"C:\GUI development\Patient Smart Home Data")
            save_dir.mkdir(parents=True, exist_ok=True)
            timestamp = time.strftime("%Y-%m-%d")
            pd.DataFrame(tempA, columns=["Time", "Temperature"]).to_csv(save_dir / f"tempA_{timestamp}.csv", index=False)
            pd.DataFrame(tempB, columns=["Time", "Temperature"]).to_csv(save_dir / f"tempB_{timestamp}.csv", index=False)
            pd.DataFrame(motionA, columns=["Time", "Motion Detected"]).to_csv(save_dir / f"motionA_{timestamp}.csv", index=False)
            pd.DataFrame(motionB, columns=["Time", "Motion Detected"]).to_csv(save_dir / f"motionB_{timestamp}.csv", index=False)
            pd.DataFrame(humidityA, columns=["Time", "Humidity"]).to_csv(save_dir / f"humidityA_{timestamp}.csv", index=False)
            pd.DataFrame(humidityB, columns=["Time", "Humidity"]).to_csv(save_dir / f"humidityB_{timestamp}.csv", index=False)
            pd.DataFrame(accel_data, columns=["Time", "Ax", "Ay", "Az", "Atotal", "Roll", "Pitch", "Yaw", "AngleTotal"]).to_csv(save_dir / f"sensor_data_{timestamp}.csv", index=False)
            print(f"Daily data saved to {save_dir}")
        except Exception as e:
            print(f"[save_data_to_csv Error] {e}")

    def check_time_for_export(self):
        try:
            current_time = time.strftime("%H:%M")
            if current_time == "00:00":
                self.save_data_to_csv()
        except Exception as e:
            print(f"[check_time_for_export Error] {e}")

    def closeEvent(self, event):
        print("[MainWindow] Closing application")
        self.timer.stop()
        self.daily_timer.stop()
        event.accept()

