class SerialReaderThread(QThread):
    dataSignal = pyqtSignal(str, str)

    def __init__(self, com_port, device_name):
        super().__init__()
        self.com_port = com_port
        self.device_name = device_name
        self.running = True
        self.ser = None

    def run(self):
        try:
            self.ser = serial.Serial(self.com_port, BAUD_RATE, timeout=0.1)  # Reduced timeout
            print(f"[SerialReaderThread] Connected to {self.com_port}")
            while self.running:
                data = self.ser.readline().decode(errors='ignore').strip()
                if data:
                    print(f"[Received] {data} from {self.com_port}")  # Debug print
                    self.dataSignal.emit(data, self.device_name)
        except serial.SerialException as e:
            print(f"[Serial Error] Could not open port {self.com_port}: {e}")
        except Exception as e:
            print(f"[SerialReaderThread Error] {e}")

    def stop(self):
        self.running = False
        if self.ser and self.ser.is_open:
            self.ser.close()
        self.wait()

def send_sms(body):
    try:
        client = Client(TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN)
        message = client.messages.create(
            body=body,
            from_=TWILIO_PHONE_NUMBER,
            to=TO_PHONE_NUMBER
        )
        print(f"[Twilio] SMS sent successfully: SID {message.sid}")
    except TwilioRestException as e:
        print(f"[Twilio Error] {e.code} - {e.msg}")
    except Exception as e:
        print(f"[Twilio Exception] An unexpected error occurred: {e}")

class AccelerometerReaderThread(QThread):
    sensorSignal = pyqtSignal(float, float, float, float, float, float, float, float)

    def __init__(self, com_port):
        super().__init__()
        self.com_port = com_port
        self.running = True
        self.ser = None
        self.last_sms_time = 0
        self.SMS_COOLDOWN = 60

    def run(self):
        try:
            self.ser = serial.Serial(self.com_port, BAUD_RATE, timeout=0.1)  # Reduced timeout
            print(f"[AccelerometerReaderThread] Connected to {self.com_port}")
            while self.running:
                try:
                    byte = self.ser.read(1)
                    if byte == b'\x55':
                        next_byte = self.ser.read(1)
                        if next_byte == b'\x61':
                            raw_data = b'\x55\x61' + self.ser.read(18)
                            if len(raw_data) == 20:
                                ax = struct.unpack('<h', raw_data[2:4])[0] / 32768.0 * 16.0 * 9.8
                                ay = struct.unpack('<h', raw_data[4:6])[0] / 32768.0 * 16.0 * 9.8
                                az = struct.unpack('<h', raw_data[6:8])[0] / 32768.0 * 16.0 * 9.8
                                atotal = np.sqrt(ax**2 + ay**2 + az**2)
                                roll = struct.unpack('<h', raw_data[14:16])[0] / 32768.0 * 180.0
                                pitch = struct.unpack('<h', raw_data[16:18])[0] / 32768.0 * 180.0
                                yaw = struct.unpack('<h', raw_data[18:20])[0] / 32768.0 * 180.0
                                angle_total = np.sqrt(roll**2 + pitch**2 + yaw**2)

                                print(f"[Sensor Data] Accel: Ax={ax:.2f}, Ay={ay:.2f}, Az={az:.2f}, Atotal={atotal:.2f} m/s² | "
                                      f"Angles: Roll={roll:.2f}, Pitch={pitch:.2f}, Yaw={yaw:.2f}, AngleTotal={angle_total:.2f} °")

                                current_time = time.time()
                                if atotal > 15.0 and (current_time - self.last_sms_time >= self.SMS_COOLDOWN):
                                    send_sms("Fall detected with individual, please check in on them")
                                    self.last_sms_time = current_time

                                self.sensorSignal.emit(ax, ay, az, atotal, roll, pitch, yaw, angle_total)
                except Exception as e:
                    print(f"[Sensor Error] {e}")
                    time.sleep(0.01)
        except serial.SerialException as e:
            print(f"[Serial Error] Could not open port {self.com_port}: {e}")
        except Exception as e:
            print(f"[AccelerometerReaderThread Error] {e}")

    def stop(self):
        self.running = False
        if self.ser and self.ser.is_open:
            self.ser.close()
        self.wait()

